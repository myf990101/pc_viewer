{
    "name": "ROS Noetic Dev Container",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "mounts": [
    "source=/home/roborock/下载/tof_tools,target=/root/tof_tools,type=bind"
    ],
    "workspaceFolder": "/root/tof_tools",
    "runArgs": [
        "--network", "host",
        "--privileged"
    ],
    "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
    },
    "extensions": [
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros"
    ],
    // "postCreateCommand": "./opt/ros/noetic/setup.bash"
}
