<launch>
     <node pkg="log_replay" name="mapping3d" type="mapping3d" required="true" output="screen">
         <rosparam file="$(find log_replay)/../config/mapping3d.yaml" command="load"/>
    </node>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find log_replay)/rviz/mapping3d.rviz"/>

    <node pkg="log_replay" name="keyboard_publisher" type="keyboard_client.py" output="screen"/>
</launch>
