<launch>
    <node pkg="log_replay" name="wire_detection" type="wire_detection" required="true" output="screen">
         <rosparam file="$(find log_replay)/../config/wire_detection.yaml" command="load"/>
    </node>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find log_replay)/rviz/wire_detection.rviz"/>

    <node pkg="log_replay" name="keyboard_publisher" type="keyboard_client.py" output="screen"/>
</launch>
