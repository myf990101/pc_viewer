<launch>
     <node pkg="log_replay" name="classify" type="classify" required="true" output="screen">
         <rosparam file="$(find log_replay)/../config/classify.yaml" command="load"/>
    </node>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find log_replay)/rviz/classify.rviz"/>

    <node pkg="log_replay" name="keyboard_publisher" type="keyboard_client.py" output="screen"/>
</launch>
